PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/AmazonClone
# Optional comma-separated DNS resolvers, useful in restricted networks:
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1,8.8.4.4
JWT_SECRET=replace-with-a-long-random-secret
# Optional token required by the demo order-status endpoint:
ORDER_STATUS_TOKEN=
PRODUCT_ADMIN_TOKEN=
# Used only by `npm run seed:admin` (and the development fallback admin):
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
CLIENT_URL=http://localhost:5173
