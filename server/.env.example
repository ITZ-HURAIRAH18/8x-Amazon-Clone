PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/AmazonClone
# Optional comma-separated DNS resolvers, useful in restricted networks:
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1,8.8.4.4
JWT_SECRET=replace-with-a-long-random-secret
# Optional token required by the demo order-status endpoint:
ORDER_STATUS_TOKEN=
PRODUCT_ADMIN_TOKEN=
# Administrator account. Leave blank to let `npm run seed:admin` ask you
# interactively, or fill all three and re-run to create or update the account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLIENT_URL=http://localhost:5173
