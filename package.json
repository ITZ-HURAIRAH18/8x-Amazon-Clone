{
  "name": "amazon-clone",
  "version": "1.0.0",
  "private": true,
  "description": "High-fidelity Amazon.com shopping experience built with the MERN stack",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:coupons": "npm run seed:coupons --workspace server",
    "seed:admin": "npm run seed:admin --workspace server",
    "smoke": "npm run smoke --workspace server",
    "smoke:admin": "npm run smoke:admin --workspace server",
    "verify:deploy": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
